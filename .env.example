# CloudOps AI Environment Configuration (Template)

# Application Metadata
APP_NAME="CloudOps AI"
APP_VERSION="1.0.0"

# AWS Region Configuration
AWS_REGION=us-east-1

# Amazon Bedrock Model Configuration
# Supported models: amazon.nova-lite-v1:0, anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Groq AI Copilot
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# (Optional) AWS CLI Credentials - Required for live AWS data
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
